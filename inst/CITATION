## Citation information for multiScaleR.
## Shown by citation("multiScaleR") and on the package website.

citHeader("To cite multiScaleR in publications, please cite the paper describing the method and the package version used.")

## The package version comes from DESCRIPTION. The year comes from the
## build date when available (CRAN and installed builds) and otherwise
## from the current date (source checkouts).
pkg_date <- if (!is.null(meta$Date)) meta$Date else meta$Packaged
pkg_year <- if (!is.null(pkg_date)) sub("-.*", "", pkg_date) else format(Sys.Date(), "%Y")

## Paper describing the method.
bibentry(
  bibtype = "Article",
  key     = "Peterman2026",
  title   = "multiScaleR: a generalizable approach for multiscale ecological modeling and scale of effect estimation",
  author  = person("William E.", "Peterman"),
  journal = "Landscape Ecology",
  year    = "2026",
  volume  = "41",
  number  = "1",
  pages   = "8",
  doi     = "10.1007/s10980-025-02267-x"
)

## The software itself, so the version used is recorded.
bibentry(
  bibtype = "Manual",
  key     = "multiScaleR",
  title   = "multiScaleR: Methods for Optimizing Scales of Effect",
  author  = person("William E.", "Peterman"),
  year    = pkg_year,
  note    = paste("R package version", meta$Version),
  url     = "https://github.com/wpeterman/multiScaleR"
)
